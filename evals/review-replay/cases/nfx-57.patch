+        script = os.path.join(self.home, ".claude", "hooks", "nousfx-drift.py")
+        self.assertTrue(os.path.exists(script))
+        self.assertEqual(hook["command"], f'python3 -I -B "{script}" --repo "{self.repo}" --tools claude')
