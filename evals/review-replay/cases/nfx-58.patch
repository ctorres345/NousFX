@@ -0,0 +1,11 @@
+---
+name: prototype-fidelity
+description: Work based on an approved prototype or design (artifact, Figma, mockup) where the prototype is the spec. Use when creating or refining tickets from it, implementing its UI, reviewing that UI, or writing the PR.
+---
+
+The prototype is the spec. Apply the step that matches where you are.
+
+1. **Tickets:** every ticket built from the prototype links it AND names the artboard or screen. It carries the acceptance criterion "matches the prototype: colors, sizes, radii, spacing, icons, states (open/pressed/selected/empty/dark)", with the concrete values that matter written in the ticket, not only a link. When creating or refining such a ticket, add this if missing.
+2. **Implementing:** open and read the prototype source (not only the ticket text) before writing UI code, and list its concrete values (tokens, colors per element, dimensions, radii) in the plan. If the app lacks a token the prototype uses, say so and name the ticket that adds it.
+3. **Review:** `review-loop` hands the reviewer the prototype and asks it to list visual deviations as findings. Before opening the PR, compare the emulator screenshots against the prototype yourself.
+4. **PR:** the description states what was checked against the prototype and what deliberately differs (and which ticket covers it).
diff --git a/scripts/test_rules_single_copy.py b/scripts/test_rules_single_copy.py
new file mode 100644
index 0000000..9e4c3af
--- /dev/null
+++ b/scripts/test_rules_single_copy.py
@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+"""Each rule lives in one source file, and the always-loaded Claude rules stay short (NFX-58).
+
+Run: python3 -B scripts/test_rules_single_copy.py
+
+Sources compared: harness/AGENTS.md, every harness/overlays/*.md, and claude/CLAUDE.delegation.md while it
+still exists (install.sh reads it until NFX-48 retires it). A rule counts as repeated when the same
+sentence (6 words or more, case and spacing ignored) appears in two different files.
+"""
+import glob
+import os
+import re
+import sys
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(HERE)
+sys.path.insert(0, HERE)
+import nousfx_sync  # noqa: E402
+
+MIN_WORDS = 6
+CLAUDE_RULES_BUDGET = 4096  # bytes: AGENTS.md + Claude overlay, what every Claude session loads
+
+
+def sources():
+    paths = [os.path.join(ROOT, "harness", "AGENTS.md")]
+    paths += sorted(glob.glob(os.path.join(ROOT, "harness", "overlays", "*.md")))
+    legacy = os.path.join(ROOT, "claude", "CLAUDE.delegation.md")
+    if os.path.exists(legacy):
+        paths.append(legacy)
+    return paths
+
+
+def sentences(text):
+    text = re.sub(r"`", "", text)
+    for chunk in re.split(r"(?<=[.!?:;])\s+|\n+", text):
+        chunk = " ".join(chunk.lstrip("-* #").lower().split())
+        if len(chunk.split()) >= MIN_WORDS:
+            yield chunk
+
+
+class SingleCopy(unittest.TestCase):
+    def test_no_sentence_appears_in_two_files(self):
+        seen, repeated = {}, []
+        for path in sources():
+            with open(path, encoding="utf-8") as f:
+                for s in set(sentences(f.read())):
+                    name = os.path.relpath(path, ROOT)
+                    if s in seen and seen[s] != name:
+                        repeated.append(f"{seen[s]} and {name}: {s[:90]}")
+                    seen.setdefault(s, name)
+        self.assertEqual(repeated, [], "the same rule is written in more than one file")
+
+    def test_always_loaded_claude_rules_fit_the_budget(self):
+        size = 0
+        for rel in ("harness/AGENTS.md", "harness/overlays/claude.overlay.md"):
+            with open(os.path.join(ROOT, rel), "rb") as f:
+                size += len(f.read())
+        self.assertLessEqual(size, CLAUDE_RULES_BUDGET,
+                             f"Claude rules are {size} bytes; move on-use rules into their skill or hook")
+
+    def test_built_rules_use_only_the_listed_sources(self):
+        # build_rules reads the same two files (plus the optional local files, absent here).
+        built = nousfx_sync.build_rules(ROOT, os.path.join(ROOT, "no-such-state"))
+        for rel in ("harness/AGENTS.md", "harness/overlays/claude.overlay.md"):
+            with open(os.path.join(ROOT, rel), encoding="utf-8") as f:
+                self.assertIn(f.read().strip("\n"), built)
+
+
+if __name__ == "__main__":
+    unittest.main()
